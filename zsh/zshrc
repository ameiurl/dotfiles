# vs 搜索词 [文件类型]
vs() {
    local pattern="${1:-import}"
    local cmd="rg -l '$pattern'"
    
    [[ -n "$2" ]] && cmd+=" -t $2"
    
    local file=$(eval "$cmd" | fzf --preview "rg -n --color=always -C 3 '$pattern' {}")
    
    [[ -z "$file" ]] && return
    
    # 获取第一个匹配的行号
    local line=$(rg -n "$pattern" "$file" | head -1 | cut -d: -f1)
    
    vi +"$line" "$file"
}

# tmux自动窗口名 NerdFont图标：deepseek鲸鱼 / claude太阳花 / 目录
function _tmux_set_win_title {
  [[ -z "$TMUX" ]] && return

  local cmd="$1"

  if [[ "$cmd" =~ "^(dst|dsh)" ]]; then
    tmux rename-window "🐳 dst"
  elif [[ "$cmd" =~ "^claude" ]]; then
    tmux rename-window "☀️ claude"
  elif [[ "$cmd" =~ "^npm run serve" ]]; then
    tmux rename-window "⚡serve"
  elif [[ "$cmd" =~ "^tail "("-f"|"-F") ]]; then
    tmux rename-window "📜 logs"
  elif [[ "$cmd" =~ "^(nvim|vim|vi)" ]]; then
    # nvim打开，取当前目录basename
    local dir="${PWD##*/}"
    tmux rename-window " ${dir}"
  else
    local dir="${PWD##*/}"
    tmux rename-window " ${dir}"
  fi
}

preexec() {
  _tmux_set_win_title "$1"
}

precmd() {
  _tmux_set_win_title ""
}
