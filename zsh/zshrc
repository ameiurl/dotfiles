# vs 搜索词 [文件类型]
vs() {
    local pattern="${1:-import}"
    local cmd="rg -l '$pattern'"
    
    [[ -n "$2" ]] && cmd+=" -t $2"
    
    local file=$(eval "$cmd" | fzf --preview "rg -n --color=always -C 3 '$pattern' {}")
    
    [[ -z "$file" ]] && return
    
    # 获取第一个匹配的行号
    local line=$(rg -n "$pattern" "$file" | head -1 | cut -d: -f1)
    
    vi +"$line" "$file"
}

# tmux自动窗口名 NerdFont图标：deepseek鲸鱼 / claude太阳花 / 目录
#
# 坑：tmux rename-window 不带 -t 时改的是「当前激活窗口」，不是执行命令的那个
# 窗口。别的窗口跑完一条命令触发 precmd/preexec 时，会把你正在看的窗口改成
# 那边的目录名。所以下面统一用 -t "$TMUX_PANE" 锁到自己这个 pane 所在的窗口。
_tmux_rename_win() {
  if [[ -n "$TMUX_PANE" ]]; then
    tmux rename-window -t "$TMUX_PANE" "$1"
  else
    tmux rename-window "$1"
  fi
}

function _tmux_set_win_title {
  [[ -n "$TMUX" ]] || return

  local cmd="$1"
  local dir="${PWD##*/}"
  [[ -n "$dir" ]] || dir='/'   # 根目录

  # 去掉行首空白（" dst" 这种）和 sudo / env / nohup / time … 前缀
  local lead i
  for i in 1 2 3; do
    lead="${cmd%%[![:space:]]*}"
    cmd="${cmd#"$lead"}"
    if [[ "$cmd" =~ '^(sudo|command|nohup|time|nice|env|builtin|exec)[[:space:]]' ]]; then
      cmd="${cmd#*[[:space:]]}"
    else
      break
    fi
  done

  # 处理 fg 恢复后台进程场景
  if [[ "$cmd" == fg || "$cmd" == fg[[:space:]]* ]]; then
    # 取被 fg 拉回前台的作业的命令行（默认当前作业）
    local job="${cmd#fg}"
    job="${job#"${job%%[![:space:]]*}"}"
    zmodload -F zsh/parameter p:jobtexts 2>/dev/null
    local back_cmd="${jobtexts[${job:-%+}]}"
    if [[ "${back_cmd%%[[:space:]]*}" == (nvim|vim|vi) ]]; then
      _tmux_rename_win "  ${dir}"
      return
    fi
  fi

  local word="${cmd%%[[:space:]]*}"
  word="${word%%[;&|]*}"   # "dst; foo" / "dst&& foo" 也算 dst

  if [[ "$word" == (dst|dsh|dsh-tui) ]]; then
    _tmux_rename_win "🐳 dst"
  elif [[ "$word" == (claude|claude-code) ]]; then
    _tmux_rename_win "☀️ claude"
  elif [[ "$cmd" == npm[[:space:]]run[[:space:]]serve* ]]; then
    _tmux_rename_win "⚡serve"
  elif [[ "$cmd" == tail[[:space:]]-[fF]* ]]; then
    _tmux_rename_win "📜 logs"
  elif [[ "$word" == (nvim|vim|vi) ]]; then
    # nvim打开，取当前目录basename
    _tmux_rename_win "  ${dir}"
  else
    _tmux_rename_win "🖺 ${dir}"
  fi
}

preexec() {
  # $1 是用户敲的原串；这行没进 history 时 zsh 给的是空串，退回 $2
  _tmux_set_win_title "${1:-$2}"
}

precmd() {
  # 回到提示符：显示当前目录
  [[ -n "$TMUX" ]] || return
  local dir="${PWD##*/}"
  _tmux_rename_win "🖺 ${dir:-/}"
}
